NY_URBAN_USERNAME=your_email@example.com
NY_URBAN_PASSWORD=your_password

# Target Apple Calendar name (configurable)
CALENDAR_NAME=Em + Kev

# iCloud CalDAV credentials (required for GitHub Actions / cross-platform sync)
# Generate an App-Specific Password at https://account.apple.com -> Sign-In and Security -> App-Specific Passwords
ICLOUD_USERNAME=your_apple_id@example.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
